{
  "manifest_version": 3,
  "name": "ChatGPT Bridge",
  "version": "1.2.17",
  "description": "Lets CLI AI tools (Claude Code / Codex / WorkBuddy) talk to ChatGPT in the browser through a local relay.",
  "permissions": ["alarms", "tabs", "scripting", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
